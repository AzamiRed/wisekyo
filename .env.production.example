NODE_ENV=production
PORT=3000
# Behind Caddy/Nginx set TRUST_PROXY=1 and COOKIE_SECURE=true
TRUST_PROXY=
COOKIE_SECURE=false

# Must match the postgres service credentials below
POSTGRES_USER=wisekyo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wisekyo
DATABASE_URL=postgresql://wisekyo:change-me@postgres:5432/wisekyo
DATABASE_SSL=false

BOT_ENABLED=true
BOT_TOKEN=replace-with-a-new-token-from-botfather

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_MAX_AGE_MS=43200000

MAX_IMAGE_BYTES=10485760
MAX_IMAGE_FILES=20
MAX_TOTAL_IMAGE_BYTES=26214400
MAX_IMAGE_PIXELS=40000000

# Used only by: docker compose run --rm app npm run seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-password
