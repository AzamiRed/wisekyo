NODE_ENV=development
PORT=3000
# Set to the exact proxy hop count or CIDR only when running behind a trusted reverse proxy.
TRUST_PROXY=

# PostgreSQL
DATABASE_URL=postgresql://wisekyo:change-me@localhost:5432/wisekyo
DATABASE_SSL=false

# Telegram (set BOT_ENABLED=false when running only the admin panel)
BOT_ENABLED=true
BOT_TOKEN=replace-with-a-new-token-from-botfather

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_MAX_AGE_MS=43200000
COOKIE_SECURE=false

MAX_IMAGE_BYTES=10485760
MAX_IMAGE_FILES=20
MAX_TOTAL_IMAGE_BYTES=26214400
MAX_IMAGE_PIXELS=40000000
# FONT_PATH=/app/fonts/Impact.ttf

# Used only by npm run seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-password
